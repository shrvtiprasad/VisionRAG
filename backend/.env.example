# ============================================================
# VisionRAG Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git.
# ============================================================

# --- Gemini API Key ---
# Required for AI explanation generation.
# If not set, the /api/explain endpoint returns a helpful fallback explanation
# and search/find-similar continue to work normally.
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# --- Qdrant Vector DB ---
# Docker is OPTIONAL!
# By default, Qdrant will store vectors locally in a directory (embedded mode).
# If QDRANT_PATH is set, it uses local embedded storage (no Docker required!).
# If you prefer running Qdrant via Docker, comment out QDRANT_PATH and set QDRANT_URL.
QDRANT_PATH=../qdrant_local_data
# QDRANT_URL=http://localhost:6333

# Collection name for COCO image embeddings
QDRANT_COLLECTION=coco_images

# --- Image Serving ---
# Directory where COCO val2017 images are located
IMAGE_DIR=../data/coco/val2017

# --- Search Configuration ---
# Minimum cosine similarity threshold (0.0 to 1.0)
SCORE_THRESHOLD=0.15

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
